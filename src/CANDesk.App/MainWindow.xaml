<Window x:Class="CANDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CANDesk.App.Views" Title="CANDesk" Height="820" Width="1600" MinWidth="1050" MinHeight="640" Background="{DynamicResource BackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="CANDesk" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="13" Margin="0,0,16,0" />
        <Menu VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem Header="New Message Database" Command="{Binding NewMessageDatabaseCommand}" />
            <MenuItem Header="Open DBC Database..." Command="{Binding OpenDatabaseCommand}" />
            <MenuItem Header="Open Message Database (.xml)..." Command="{Binding MessageDbEditor.OpenCommand}" />
            <MenuItem Header="Save Message Database..." Command="{Binding MessageDbEditor.SaveCommand}" />
            <MenuItem Header="Export Message Database as DBC..." Command="{Binding MessageDbEditor.ExportDbcCommand}" />
            <Separator />
            <MenuItem Header="Export Trace..." Command="{Binding ExportTraceCommand}" />
            <Separator />
            <MenuItem Header="E_xit" Command="ApplicationCommands.Close" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="Undo" Command="{Binding UndoMessageEditCommand}" />
            <MenuItem Header="Redo" Command="{Binding RedoMessageEditCommand}" />
            <Separator />
            <MenuItem Header="Clear Trace" Command="{Binding ClearTraceCommand}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Auto Scroll" IsCheckable="True" IsChecked="{Binding IsAutoScroll}" />
            <MenuItem Header="Raw Hex View" IsCheckable="True" IsChecked="{Binding IsRawMode}" />
            <MenuItem Header="Decoded Signal View" IsCheckable="True" IsChecked="{Binding IsDecodedMode}" />
          </MenuItem>
          <MenuItem Header="_Hardware">
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" />
            <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}" />
            <MenuItem Header="Reset Bus" Command="{Binding ResetBusCommand}" />
          </MenuItem>
          <MenuItem Header="_Tools">
            <MenuItem Header="Load DBC..." Command="{Binding OpenDatabaseCommand}" />
            <MenuItem Header="Message DB Editor" Command="{Binding OpenMessageEditorCommand}" />
            <MenuItem Header="Settings" />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="Documentation" />
            <MenuItem Header="About CANDesk" />
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <views:DeviceConnectionView Grid.Row="1" DataContext="{Binding Connection}" />
    <Grid Grid.Row="2" Background="{DynamicResource BorderBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <TabControl Background="{DynamicResource PanelBrush}" BorderThickness="0" SelectedIndex="{Binding SelectedLeftTabIndex}">
          <TabItem Header="DBC Signal Tree">
            <views:DbcSignalTreeView DataContext="{Binding DbcSignalTree}" />
          </TabItem>
          <TabItem Header="DB Editor">
            <views:MessageDbEditorView DataContext="{Binding MessageDbEditor}" />
          </TabItem>
        </TabControl>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <TabControl Background="{DynamicResource PanelBrush}" BorderThickness="0" SelectedIndex="{Binding SelectedCenterTabIndex}">
          <TabItem Header="Trace Monitor">
            <views:TraceLogView DataContext="{Binding TraceLog}" />
          </TabItem>
          <TabItem Header="Message Monitor">
            <views:MessageMonitorView DataContext="{Binding Monitor}" />
          </TabItem>
          <TabItem Header="Transmit">
            <views:TransmitPanelView DataContext="{Binding TransmitPanel}" />
          </TabItem>
          <TabItem Header="Signal Plot" />
          <TabItem Header="Diagnostics" />
        </TabControl>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="12,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{Binding BusStatusBrush}" Margin="0,0,6,0">
            <Ellipse.Effect>
              <DropShadowEffect Color="{Binding BusStatusBrush.Color}" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
            </Ellipse.Effect>
          </Ellipse>
          <TextBlock Text="{Binding DeviceStatusText}" Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text="  |  Bus: " Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0" />
          <TextBlock Text="{Binding BusStatusText}" Foreground="{Binding BusStatusBrush}" />
          <TextBlock Text="  |  Bus Load:" Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,4,0" />
          <Border Width="60" Height="6" CornerRadius="3" Background="{DynamicResource PanelDarkerBrush}" VerticalAlignment="Center">
            <Border Width="{Binding BusLoadBarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
          </Border>
          <TextBlock Text="{Binding BusLoadText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="4,0,0,0" />
          <TextBlock Text="{Binding LastDeviceError}" Foreground="{DynamicResource FailBrush}" Margin="14,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="RX: " Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text="{Binding RxRate}" Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text=" fps    TX: " Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text="{Binding TxRate}" Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text=" fps    Dropped: " Foreground="{DynamicResource TextSubBrush}" />
          <TextBlock Text="{Binding DroppedFrameCount}" Foreground="{Binding DroppedFrameBrush}" FontWeight="SemiBold" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
