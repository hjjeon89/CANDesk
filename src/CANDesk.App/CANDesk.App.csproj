<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>icon\main_window_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Glob (not one entry per file) so a new icon under icon/ referenced from XAML via a
         relative pack URI (e.g. Icon="icon/foo.ico") is automatically embedded as a resource —
         missing this is exactly what threw a XamlParseException from the Icon property's
         ImageSourceConverter for db_edit_window_icon.ico/signal_monitor_window_icon.ico, which
         were referenced from XAML but never added here. -->
    <Resource Include="icon\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CANDesk.Hal\CANDesk.Hal.csproj" />
    <ProjectReference Include="..\CANDesk.Core\CANDesk.Core.csproj" />
    <ProjectReference Include="..\CANDesk.Hal.Peak\CANDesk.Hal.Peak.csproj" />
    <ProjectReference Include="..\CANDesk.Hal.Vector\CANDesk.Hal.Vector.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vector XL Driver Library redistributable, not committed to the repo. Copied next to
         CANDesk.App.exe whenever present so VectorCanDeviceFactory's P/Invoke can find it; absent,
         it just means Vector stays unavailable in the UI (see vendor/README.md). -->
    <None Include="vendor\vxlapi64.dll" Condition="Exists('vendor\vxlapi64.dll')" CopyToOutputDirectory="PreserveNewest" Link="vxlapi64.dll" />
  </ItemGroup>
</Project>
