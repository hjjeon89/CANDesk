<UserControl x:Class="CANDesk.App.Views.DbcSignalTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search signals / messages" />
    <TreeView Grid.Row="1" ItemsSource="{Binding Messages}" Margin="0,8,0,0" Background="Transparent" BorderThickness="0">
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Signals}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
            <TextBlock Text="  {Binding Name}" />
            <TextBlock Text="  {Binding Meta}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
          </StackPanel>
          <HierarchicalDataTemplate.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="•" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSubBrush}" />
                <TextBlock Text="  {Binding Value}" Foreground="{DynamicResource PassBrush}" FontFamily="Consolas" />
              </StackPanel>
            </DataTemplate>
          </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
