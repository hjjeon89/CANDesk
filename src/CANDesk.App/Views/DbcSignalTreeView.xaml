<UserControl x:Class="CANDesk.App.Views.DbcSignalTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Style="{StaticResource SearchBoxContainerStyle}">
      <TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search Message / Signal..." />
    </Border>
    <TreeView Grid.Row="1" ItemsSource="{Binding Messages}" Margin="0,8,0,0">
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Signals}">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource IdBadgeStyle}" Margin="0,0,7,0">
              <TextBlock Style="{StaticResource IdBadgeTextStyle}" Text="{Binding Id}" />
            </Border>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Meta, StringFormat=' · {0}'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
            <Button Content="+ TX" Margin="10,0,0,0" Padding="6,1" FontSize="10"
                    ToolTip="Create a Transmit job from this message"
                    Command="{Binding DataContext.SendToTransmitCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
          <HierarchicalDataTemplate.ItemTemplate>
            <DataTemplate>
              <DockPanel MinWidth="180">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource PassBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="14,0,0,0" />
              </DockPanel>
            </DataTemplate>
          </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
