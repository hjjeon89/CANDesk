<UserControl x:Class="CANDesk.App.Views.MessageDbEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <Button Content="+ Add Message" Command="{Binding AddMessageCommand}" />
      <Button Content="Save..." Command="{Binding SaveCommand}" Margin="6,0,0,0" ToolTip="Save the message database to a CANDesk XML file" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SaveError}" Foreground="{DynamicResource FailBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="90" />
        <DataGridTextColumn Header="Message" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="55" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
