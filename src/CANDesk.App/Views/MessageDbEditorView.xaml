<UserControl x:Class="CANDesk.App.Views.MessageDbEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="8">
    <Button DockPanel.Dock="Top" Content="+ Add Message" Command="{Binding AddMessageCommand}" HorizontalAlignment="Left" />
    <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="90" />
        <DataGridTextColumn Header="Message" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="55" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
