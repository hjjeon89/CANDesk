<UserControl x:Class="CANDesk.App.Views.DeviceConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="12,7">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="VENDOR" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
          <ComboBox Width="105" ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" VerticalAlignment="Center" />
          <TextBlock Text="CHANNEL" Style="{StaticResource CaptionTextStyle}" Margin="12,0,6,0" VerticalAlignment="Center" />
          <ComboBox Width="150" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" VerticalAlignment="Center" />
          <Border Style="{StaticResource ToolbarSeparatorStyle}" />
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Content="Classic CAN" IsChecked="{Binding IsClassicMode, Mode=TwoWay}" BorderThickness="0" Background="Transparent" />
              <ToggleButton Content="CAN FD" IsChecked="{Binding IsFdMode, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Margin="2,0,0,0" />
            </StackPanel>
          </Border>
          <Button Content="⚡ Connect"
                  Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Margin="10,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
          <Button Content="{Binding DataContext.CaptureCommandText, RelativeSource={RelativeSource AncestorType=Window}}"
                  Command="{Binding DataContext.ToggleCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Content="⟲ Clear"
                  Command="{Binding DataContext.ClearTraceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="5,0,0,0" />
          <ToggleButton Content="⚡ Auto Scroll"
                        IsChecked="{Binding DataContext.IsAutoScroll, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="5,0,0,0" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1"
              Margin="0,8,0,0"
              Padding="8,6"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderSubBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="NOMINAL / ARBITRATION" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <ComboBox Width="170" ItemsSource="{Binding NominalPresets}" SelectedItem="{Binding SelectedNominalTiming}" />
            <ToggleButton Content="Custom" IsChecked="{Binding UseCustomNominalTiming}" Margin="6,0,0,0" />
            <TextBox Width="60" Margin="6,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding CustomNominalBitrateKbps, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomNominalTiming}" ToolTip="Nominal bitrate (kbps) — enable Custom to edit" />
            <TextBox Width="52" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding CustomNominalSamplePoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomNominalTiming}" ToolTip="Nominal sample point (%) — enable Custom to edit" />
            <ToggleButton Content="Advanced" IsChecked="{Binding UseRawNominalTiming}" Margin="6,0,0,0" ToolTip="Enter BRP, TSeg1, TSeg2, and SJW directly" />
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource ToolbarSeparatorStyle}" />
          <TextBlock Grid.Column="3" Text="DATA PHASE (CAN FD)" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsFdMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Visibility="{Binding IsFdMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ComboBox Width="170" ItemsSource="{Binding DataPresets}" SelectedItem="{Binding SelectedDataTiming}" />
            <ToggleButton Content="Custom" IsChecked="{Binding UseCustomDataTiming}" Margin="6,0,0,0" />
            <TextBox Width="60" Margin="6,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding CustomDataBitrateKbps, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomDataTiming}" ToolTip="Data bitrate (kbps) — enable Custom to edit" />
            <TextBox Width="52" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding CustomDataSamplePoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomDataTiming}" ToolTip="Data sample point (%) — enable Custom to edit" />
            <ToggleButton Content="Advanced" IsChecked="{Binding UseRawDataTiming}" Margin="6,0,0,0" ToolTip="Enter BRP, TSeg1, TSeg2, and SJW directly" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Visibility="{Binding UseRawNominalTiming, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="BRP" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding NominalPrescaler, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="TSEG1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding NominalTseg1, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="TSEG2" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding NominalTseg2, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="SJW" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding NominalSjw, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding NominalRawDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
          <WrapPanel Grid.Row="1" Grid.Column="4" Margin="0,7,0,0" Visibility="{Binding UseRawDataTiming, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="BRP" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding DataPrescaler, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="TSEG1" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding DataTseg1, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="TSEG2" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding DataTseg2, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="SJW" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="7,0,0,0" />
            <TextBox Width="44" Margin="4,0,0,0" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding DataSjw, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding DataRawDescription}" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
