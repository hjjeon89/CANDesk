<UserControl x:Class="CANDesk.App.Views.TransmitPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource PanelHeaderStyle}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="Transmit Engine" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="+ Add TX" Padding="5,2" Margin="1" Command="{Binding AddJobCommand}" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Emulate node" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding EmulatedNodes}" SelectedItem="{Binding SelectedEmulatedNode}" Width="150" Height="25" />
          <Button Content="Add node TX" Padding="8,3" Margin="7,0,0,0" Command="{Binding AddEmulatedNodeJobsCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Jobs}" Margin="8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PanelCardStyle}" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource IdBadgeStyle}" Background="{DynamicResource WarningSoftBrush}" Margin="7,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Id}" Style="{StaticResource IdBadgeTextStyle}" Foreground="{DynamicResource WarningBrush}" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cyclic" Padding="8,3" FontSize="11" Command="{Binding DataContext.ToggleCyclicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="Send Now" Style="{StaticResource PrimaryButtonStyle}" Padding="8,3" FontSize="11" Command="{Binding DataContext.SendNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,10,0,8">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="CYCLE PERIOD" Style="{StaticResource CaptionTextStyle}" />
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,3,0,0">
                      <TextBlock Text="{Binding Period}" FontFamily="{DynamicResource MonoFontFamily}" />
                    </Border>
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="DLC (BYTES)" Style="{StaticResource CaptionTextStyle}" />
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,3,0,0">
                      <TextBlock Text="{Binding Dlc}" FontFamily="{DynamicResource MonoFontFamily}" />
                    </Border>
                  </StackPanel>
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Signals}" Margin="0,0,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}" />
                        <TextBox Grid.Column="1" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="PAYLOAD (HEX)" Style="{StaticResource CaptionTextStyle}" />
                <TextBox Text="{Binding Payload}" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,3,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                  <CheckBox Content="Auto Counter" IsChecked="{Binding AutoCounter}"
                            ToolTip="AUTOSAR E2E Profile 1: 4-bit rolling counter (0-15) in the low nibble of the last payload byte. Applies once you Start the cyclic job; toggling while running takes effect on the next Start." />
                  <CheckBox Content="E2E CRC8" IsChecked="{Binding E2eCrc}" Margin="14,0,0,0"
                            ToolTip="AUTOSAR E2E Profile 1: CRC-8/AUTOSAR (poly 0x2F) written to byte 0, covering every other byte (including the rolling counter, if also enabled). Requires at least 2 payload bytes." />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding LastSendError}" Foreground="{DynamicResource FailBrush}" Margin="8,2" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
