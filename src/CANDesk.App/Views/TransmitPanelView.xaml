<UserControl x:Class="CANDesk.App.Views.TransmitPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource PanelHeaderStyle}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="Transmit Engine" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="+ Add TX" Padding="5,2" Margin="1" Command="{Binding AddJobCommand}" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Emulate node" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding EmulatedNodes}" SelectedItem="{Binding SelectedEmulatedNode}" Width="150" Height="25" />
          <Button Content="Add node TX" Padding="8,3" Margin="7,0,0,0" Command="{Binding AddEmulatedNodeJobsCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Jobs}" Margin="8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PanelCardStyle}" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <CheckBox IsChecked="{Binding IsEnabled}" IsHitTestVisible="False" VerticalAlignment="Center" ToolTip="Cyclic transmission is active" />
                  <CheckBox IsChecked="{Binding IsTriggered}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Triggered transmission is active" />
                  <Border Style="{StaticResource IdBadgeStyle}" Background="{DynamicResource WarningSoftBrush}" Margin="7,0" VerticalAlignment="Center">
                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IdBadgeTextBoxStyle}"
                             FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" FontSize="11"
                             Foreground="{DynamicResource WarningBrush}" CaretBrush="{DynamicResource WarningBrush}"
                             ToolTip="CAN ID in hex, e.g. 0x100. IDs above 0x7FF auto-check &quot;Ext&quot; below." />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Content="Ext" IsChecked="{Binding IsExtended}" VerticalAlignment="Center" Margin="10,0,0,0"
                            ToolTip="29-bit extended CAN ID. Auto-checked when the ID is above 0x7FF; uncheck only if you need a small ID sent as extended anyway." />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cyclic" Padding="8,3" FontSize="11" Command="{Binding DataContext.ToggleCyclicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="Trigger" Padding="8,3" FontSize="11" Command="{Binding DataContext.ToggleTriggeredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Content="Send Now" Style="{StaticResource PrimaryButtonStyle}" Padding="8,3" FontSize="11" Command="{Binding DataContext.SendNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </StackPanel>
                </DockPanel>
                <UniformGrid Columns="2" Margin="0,10,0,8">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="CYCLE PERIOD" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,3,0,0"
                             ToolTip="e.g. '20 ms'. 0 (or blank) means Send Now only — pressing Cyclic won't start anything. Applies the next time Cyclic is started; editing while already running has no effect until Stop then Cyclic again." />
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="DLC (BYTES)" Style="{StaticResource CaptionTextStyle}" />
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,3,0,0">
                      <TextBlock Text="{Binding Dlc}" FontFamily="{DynamicResource MonoFontFamily}" />
                    </Border>
                  </StackPanel>
                </UniformGrid>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Signals.Count}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ToggleButton Style="{StaticResource SectionExpanderToggleStyle}" IsChecked="{Binding IsSignalsExpanded, Mode=TwoWay}" Margin="0,6,0,2">
                    <TextBlock Text="{Binding Signals.Count, StringFormat='SIGNAL VALUES ({0})'}" Style="{StaticResource CaptionTextStyle}" />
                  </ToggleButton>
                  <ItemsControl ItemsSource="{Binding Signals}" Margin="0,0,0,4">
                    <ItemsControl.Style>
                      <Style TargetType="ItemsControl">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSignalsExpanded}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="76" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}" />
                          <TextBox Grid.Column="1" Style="{StaticResource CompactNumberBoxStyle}" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Text="PAYLOAD (HEX)" Style="{StaticResource CaptionTextStyle}" />
                <TextBox Text="{Binding Payload}" FontFamily="{DynamicResource MonoFontFamily}" Margin="0,3,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                  <CheckBox Content="Auto Counter" IsChecked="{Binding AutoCounter}"
                            ToolTip="AUTOSAR E2E Profile 1: 4-bit rolling counter (0-15) in the low nibble of the last payload byte. Applies once you Start the cyclic job; toggling while running takes effect on the next Start." />
                  <CheckBox Content="E2E CRC8" IsChecked="{Binding E2eCrc}" Margin="14,0,0,0"
                            ToolTip="AUTOSAR E2E Profile 1: CRC-8/AUTOSAR (poly 0x2F) written to byte 0, covering every other byte (including the rolling counter, if also enabled). Requires at least 2 payload bytes." />
                </StackPanel>
                <UniformGrid Columns="5" Margin="0,9,0,0">
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="TRIGGER ID" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding TriggerId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="RX CAN ID to match, e.g. 0x7E0" />
                  </StackPanel>
                  <StackPanel Margin="5,0">
                    <TextBlock Text="MASK" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding TriggerMask, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="CAN ID mask, e.g. 0x7FF" />
                  </StackPanel>
                  <StackPanel Margin="5,0">
                    <TextBlock Text="PAYLOAD PREFIX" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding TriggerPayloadPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="Optional leading bytes to match, e.g. 02 10" />
                  </StackPanel>
                  <StackPanel Margin="5,0">
                    <TextBlock Text="DELAY MS" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding ResponseDelayMs, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="Delay before responding in milliseconds" />
                  </StackPanel>
                  <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="REPEAT" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip="Blank means respond every time; otherwise stop after this many matches" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding LastSendError}" Foreground="{DynamicResource FailBrush}" Margin="8,2" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
