<UserControl x:Class="CANDesk.App.Views.TransmitPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Style="{StaticResource PanelHeaderStyle}">
      <DockPanel>
        <TextBlock Text="Transmit Engine" FontWeight="SemiBold" />
        <Button DockPanel.Dock="Right" Content="+ Add TX" Padding="7,2" Command="{Binding AddJobCommand}" />
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Jobs}" Margin="8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource PanelCardStyle}" Padding="10" Margin="0,0,0,8">
              <StackPanel>
                <DockPanel>
                  <CheckBox IsChecked="{Binding IsEnabled}" />
                  <TextBlock Text="{Binding Id}" Foreground="{DynamicResource WarningBrush}" FontFamily="Consolas" FontWeight="Bold" Margin="7,0" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <Button DockPanel.Dock="Right" Content="Send Now" Padding="7,2" />
                </DockPanel>
                <TextBlock Text="{Binding Period}" Margin="0,7,0,2" Foreground="{DynamicResource TextSubBrush}" />
                <TextBox Text="{Binding Payload}" FontFamily="Consolas" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <CheckBox Content="Auto Counter" IsChecked="{Binding AutoCounter}" />
                  <CheckBox Content="E2E CRC8" IsChecked="{Binding E2eCrc}" Margin="12,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
