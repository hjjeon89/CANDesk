<Window x:Class="CANDesk.App.SignalMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal Monitor" Width="760" Height="560" MinWidth="480" MinHeight="320"
        Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="8,6"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderSubBrush}"
            BorderThickness="1"
            CornerRadius="6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Text="FILTER" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Border Style="{StaticResource SearchBoxContainerStyle}" Width="180">
            <TextBox Style="{StaticResource SearchTextBoxStyle}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Signal name, message name, or CAN ID" />
          </Border>
          <Button Content="⟲ Clear" Command="{Binding ClearCommand}" Margin="12,0,0,0" ToolTip="Remove all rows" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="One row per decoded signal" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource PanelCardStyle}">
      <DataGrid ItemsSource="{Binding RowsView}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                BorderThickness="0"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="CAN ID" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource IdBadgeStyle}" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource IdBadgeTextStyle}" Text="{Binding Id}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="150" />
          <DataGridTextColumn Header="Signal" Binding="{Binding SignalName}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
          <DataGridTextColumn Header="Last Received" Binding="{Binding LastReceived, StringFormat=HH:mm:ss.fff}" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
