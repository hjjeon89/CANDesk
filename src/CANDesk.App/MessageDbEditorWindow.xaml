<Window x:Class="CANDesk.App.MessageDbEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message DB Editor" Width="920" Height="600" MinWidth="720" MinHeight="460">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelCardStyle}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
          <DockPanel><TextBlock Text="Messages" FontWeight="SemiBold" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Save..." Command="{Binding SaveCommand}" ToolTip="Save the message database to a CANDesk XML file" /><Button Content="Remove" Command="{Binding RemoveSelectedMessageCommand}" /><Button Content="+ Add Message" Command="{Binding AddMessageCommand}" /></StackPanel></DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
          <DataGrid.Columns><DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="90" /><DataGridTextColumn Header="Message" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50" /></DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
          <TextBlock Text="Message Details" FontWeight="SemiBold" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Properties" Style="{StaticResource CaptionTextStyle}" />
            <Grid Margin="0,6,0,0" IsEnabled="{Binding HasSelectedMessage}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
              </Grid.RowDefinitions>
              <TextBlock Text="CAN ID" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding MessageIdText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MessageNameText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Row="2" Text="DLC" VerticalAlignment="Center" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Text="{Binding MessageDlcText, UpdateSourceTrigger=PropertyChanged}" Width="54" />
                <CheckBox Content="Extended ID" IsChecked="{Binding IsExtendedMessage}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Button Content="Apply changes" Command="{Binding ApplySelectedMessageCommand}" HorizontalAlignment="Right" Margin="0,7,0,0" />
            <TextBlock Text="{Binding EditError}" Foreground="{DynamicResource FailBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />

            <Separator Margin="0,14,0,12" />
            <DockPanel>
              <TextBlock Text="Node Assignment" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Remove" Command="{Binding RemoveSelectedNodeCommand}" />
                <Button Content="+ Add Node" Command="{Binding AddNodeCommand}" Margin="6,0,0,0" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="Select TX (one) and RX (multiple) nodes for the selected message."
                       Foreground="{DynamicResource TextSubBrush}" FontSize="11" Margin="0,5,0,6" />
            <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" BorderThickness="0" IsEnabled="{Binding HasSelectedMessage}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <RadioButton Grid.Column="1" Content="TX" IsChecked="{Binding IsTransmitter}" GroupName="Transmitter" />
                    <CheckBox Grid.Column="2" Content="RX" IsChecked="{Binding IsReceiver}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
      <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource FailBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
